{
  "name": "athenvia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @athenvia/web --filter @athenvia/worker dev",
    "dev:web": "pnpm --filter @athenvia/web dev",
    "dev:worker": "pnpm --filter @athenvia/worker dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @athenvia/database db:generate",
    "db:validate": "pnpm --filter @athenvia/database db:validate",
    "db:migrate": "pnpm --filter @athenvia/database db:migrate",
    "db:seed": "pnpm --filter @athenvia/database db:seed",
    "db:seed:check": "pnpm --filter @athenvia/database db:seed:check",
    "vapid:generate": "web-push generate-vapid-keys"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "web-push": "^3.6.7"
  }
}
