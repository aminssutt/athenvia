    "pino": "^10.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@athenvia/config": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
