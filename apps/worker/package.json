{
  "name": "@athenvia/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "tsx watch --exclude \"../../node_modules/**\" --exclude \"**/node_modules/**\" src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "test": "tsx --test tests/*.test.ts \"src/**/*.test.ts\"",
    "test:redis-smoke": "tsx tests/redis-smoke.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@athenvia/contracts": "workspace:*",
    "@athenvia/database": "workspace:*",
    "@prisma/client": "6.19.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.0.0",
    "pino": "^10.0.0",
    "tsx": "^4.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@athenvia/config": "workspace:*",
    "@types/node": "^26.1.2",
    "playwright": "^1.58.0",
    "typescript": "^5.9.0"
  }
}
