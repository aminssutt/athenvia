{
  "name": "@athenvia/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test tests/*.test.ts",
    "test:submission-smoke": "tsx tests/university-submissions.smoke.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/seed.ts",
    "test:program-submissions:integration": "tsx tests/program-submissions.integration.ts",
    "test:watchlists:integration": "tsx tests/watchlists.integration.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@athenvia/config": "workspace:*",
    "@types/node": "^24.0.0",
    "prisma": "6.19.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
