# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://athenvia:athenvia@localhost:5432/athenvia

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Authentication (replace locally; never commit real values)
AUTH_SECRET=replace-with-a-random-secret
AUTH_EMAIL_FROM=Athenvia <noreply@example.com>
AUTH_EMAIL_SERVER=smtp://username:password@localhost:1025

# Web Push (generate a distinct pair per environment with `pnpm vapid:generate`)
# The web app exposes VAPID_PUBLIC_KEY through /api/push/vapid-public-key.
# Store VAPID_PRIVATE_KEY only in server/worker secret storage.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
