# Copy this file to .env. Never commit the resulting .env.

# Deployment
ATHENVIA_IMAGE_TAG=local
APP_URL=http://localhost:3000

# PostgreSQL
# Keep POSTGRES_PASSWORD URL-safe: letters, numbers, "_" and "-" only.
POSTGRES_DB=athenvia
POSTGRES_USER=athenvia
POSTGRES_PASSWORD=replace_with_a_long_url_safe_password
POSTGRES_PORT=5432

# Redis / BullMQ
REDIS_PASSWORD=replace_with_a_different_long_url_safe_password
REDIS_PORT=6379

# Authentication
AUTH_SECRET=replace_with_at_least_32_random_bytes
AUTH_EMAIL_FROM="Athenvia <noreply@example.com>"
# Configure either AUTH_EMAIL_SERVER or AUTH_RESEND_API_KEY for email magic links.
AUTH_EMAIL_SERVER=
AUTH_RESEND_API_KEY=
ATHENVIA_ADMIN_EMAILS=admin@example.com

# Google OAuth (optional; both values are required to enable the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push (generate one matching pair with `pnpm vapid:generate`)
VAPID_PUBLIC_KEY=replace_with_the_public_vapid_key
VAPID_PRIVATE_KEY=replace_with_the_private_vapid_key
VAPID_SUBJECT=mailto:admin@example.com

# Optional dedicated rate-limit salts. AUTH_SECRET is the safe fallback.
SEARCH_RATE_LIMIT_SALT=
PROGRAM_SUBMISSION_RATE_LIMIT_SALT=
UNIVERSITY_SUBMISSION_RATE_LIMIT_SALT=
